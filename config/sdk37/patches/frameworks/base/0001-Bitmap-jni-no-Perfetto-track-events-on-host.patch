                      bitmap_id)                                                                    \
     PERFETTO_TE_PROTO_FIELDS(PERFETTO_TE_PROTO_FIELD_NESTED(                                       \
@@ -225,6 +228,17 @@
 static void traceSliceEnd(void) {
     PERFETTO_TE(tracing_perfetto::track_event_categories::bitmap, PERFETTO_TE_SLICE_END());
 }
+#else
+// No track events on host: the library links neither Perfetto nor libtracing_perfetto.
