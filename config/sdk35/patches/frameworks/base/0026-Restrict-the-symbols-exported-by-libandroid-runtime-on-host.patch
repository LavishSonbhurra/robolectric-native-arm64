Restrict the symbols exported by libandroid_runtime on host

Upstream: platform/frameworks/base commit 003ace9953d, adapted to r1

Why: the official library exports 223 symbols. Adapted: Linux only, plus the
typeinfo of RefBase, VectorImpl and AndroidRuntime, which the official
library exports (no RTTI flag on host in this Soong) and SDK 36 does not.

diff --git a/core/jni/Android.bp b/core/jni/Android.bp
index 01a51ba53b9..67674ceb974 100644
--- a/core/jni/Android.bp
+++ b/core/jni/Android.bp
@@ -470,6 +470,7 @@ cc_library_shared_for_libandroid_runtime {
                 "libbinder",
                 "libhidlbase", // libhwbinder is in here
             ],
+            version_script: "platform/linux/libandroid_runtime_export.txt",
         },
         linux_glibc_x86_64: {
             ldflags: ["-static-libgcc"],
diff --git a/core/jni/platform/linux/libandroid_runtime_export.txt b/core/jni/platform/linux/libandroid_runtime_export.txt
new file mode 100644
index 00000000000..cac16661c35
--- /dev/null
+++ b/core/jni/platform/linux/libandroid_runtime_export.txt
@@ -0,0 +1,48 @@
